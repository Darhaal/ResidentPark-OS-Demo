# Copy this file to `.env.local` and fill in real values. Never commit `.env.local`.

# ─── Supabase (app runtime) ─────────────────────────────────────────────────
# Create a project at https://supabase.com, then copy these from
# Project Settings → API Keys.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-key

# Server-only, full-access key — never expose to the browser or commit it.
# Never give it a NEXT_PUBLIC_ prefix.
SUPABASE_SECRET_KEY=sb_secret_your-key

# Legacy JWT keys — read only as a fallback when the keys above are unset.
# Supabase is retiring them; prefer the publishable/secret keys.
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your-legacy-anon-key
# SUPABASE_SERVICE_ROLE_KEY=your-legacy-service-role-key

# Direct Postgres connection (Project Settings → Database → Connection string).
SUPABASE_DB_URL=postgresql://postgres:your-password@db.your-project-ref.supabase.co:5432/postgres

# ─── Public demo mode ───────────────────────────────────────────────────────
# "true" shows one-click "Sign in as Admin / Resident" on the sign-in page and the
# Demo bar. Those accounts must be listed in public.demo_readonly_accounts
# (read-only), otherwise demo sign-in is refused. Leave false everywhere else.
NEXT_PUBLIC_DEMO_MODE=false
# ─── Demo seed (scripts/seed-demo.mjs) ──────────────────────────────────────
# Shared password for the seeded demo accounts. Local/demo use only.
SEED_PASSWORD=change-me-local-only

# ─── Database + E2E tests (optional — CI provides its own) ──────────────────
# Point these at a DISPOSABLE local Supabase (`supabase start`), never production.
TEST_DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
TEST_SUPABASE_URL=http://127.0.0.1:54321
TEST_SUPABASE_ANON_KEY=your-local-anon-key
TEST_SUPABASE_SERVICE_ROLE_KEY=your-local-service-role-key

# Playwright E2E
QA_BASE_URL=http://localhost:3000
E2E_EMAIL_CONFIRM=false
INBUCKET_URL=http://127.0.0.1:54324
LOCAL_MAIL_URL=http://127.0.0.1:54324
